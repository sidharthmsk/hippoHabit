# Shared unlock key. Entered once per device.
ACCESS_KEY=change-me

# Used to sign the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-too

# Calendar dates (check-ins, streaks, heatmap) use this timezone.
APP_TIMEZONE=Asia/Kolkata

# SQLite file. In Docker this is /app/data/habits.db
DATABASE_PATH=./data/habits.db

# Host port published by docker compose (container still listens on 3000).
PUBLISH_PORT=3000
