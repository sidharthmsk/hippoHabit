# Used to sign the session cookie. Generate with: openssl rand -base64 32
# Changing it signs every device out.
AUTH_SECRET=change-me

# Password sign-in. Run: npm run hash-password
# (in Docker: docker compose run --rm habits node scripts/hash-password.mjs)
# and paste both lines it prints. AUTH_USERNAME defaults to admin.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=

# Optional OIDC sign-in (Authentik, Authelia, Pocket ID, ...).
# Redirect URI to register with the provider: <your app URL>/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Button label, e.g. Authentik. Defaults to "SSO".
OIDC_PROVIDER_NAME=
# Comma-separated emails, usernames, or subject IDs allowed in.
# Empty lets in anyone the provider authenticates for this client.
OIDC_ALLOWED_USERS=

# Public URL, e.g. https://habits.example.com. Only needed if the reverse
# proxy doesn't send X-Forwarded-Host / X-Forwarded-Proto.
APP_URL=

# Calendar dates (check-ins, streaks, heatmap) use this timezone.
APP_TIMEZONE=UTC

# SQLite file. In Docker this is /app/data/habits.db
DATABASE_PATH=./data/habits.db

# Host port published by docker compose (container still listens on 3000).
PUBLISH_PORT=3000
